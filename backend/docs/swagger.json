{
    "swagger": "2.0",
    "info": {
        "description": "Toei Transportation API",
        "title": "Train Status API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/fares": {
            "get": {
                "description": "Get IC card and ticket fare between two stations",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Fare"
                ],
                "summary": "Get fare",
                "parameters": [
                    {
                        "type": "string",
                        "example": "odpt.Station:Toei.Oedo.Daimon",
                        "description": "From station ID",
                        "name": "from",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "odpt.Station:Toei.Asakusa.Magome",
                        "description": "To station ID",
                        "name": "to",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/service.Fare"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/journeys": {
            "get": {
                "description": "Search journeys between two stations. Returns the earliest journey for each number of transfers.\nStations with the same name on different lines (e.g. Shinjuku) are treated as one station.\nTimes are on the current service day (before 03:00 belongs to the previous day).\nCurrent delays (per railway and direction, within the next hour) are added to the times, and suspended railways are avoided.\nIf the realtime status cannot be fetched, the timetable is used as is and delayApplied is false.\nWith realtime=false, delays and suspensions are ignored and the timetable is used as is.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Journey"
                ],
                "summary": "Search journeys",
                "parameters": [
                    {
                        "type": "string",
                        "example": "odpt.Station:Toei.Mita.Kasuga",
                        "description": "From station ID",
                        "name": "from",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "odpt.Station:Toei.Asakusa.Asakusa",
                        "description": "To station ID",
                        "name": "to",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "10:00",
                        "description": "Departure time (HH:MM). Defaults to now",
                        "name": "departAt",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Arrival time (HH:MM). Cannot be used with departAt",
                        "name": "arriveBy",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 3,
                        "description": "Maximum number of transfers (0-3)",
                        "name": "maxTransfers",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "odpt.Railway:Toei.Oedo",
                        "description": "Comma-separated railway IDs to avoid",
                        "name": "avoid",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "default": true,
                        "description": "Apply current delays and suspensions",
                        "name": "realtime",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/service.JourneySearch"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/routes": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Railway"
                ],
                "summary": "Get railways",
